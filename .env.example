AIHUBMIX_API_KEY=replace_with_your_key
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_MODEL=deepseek-v4.1-flash-1017
AIHUBMIX_VISION_MODEL=gpt-4o
# Structured JSON tasks: disable DeepSeek thinking to leave budget for final output.
AIHUBMIX_THINKING=disabled
AIHUBMIX_MAX_OUTPUT_TOKENS=12000

# Optional providers. A video key alone does not switch text/vision away from AIHubMix.
MODEL_PROVIDER=aihubmix
# DASHSCOPE_API_KEY=YOUR_API_KEY_HERE
# DASHSCOPE_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
# DASHSCOPE_MODEL=deepseek-v4.1-flash
# DASHSCOPE_VISION_MODEL=YOUR_SUPPORTED_VISION_MODEL
# DASHSCOPE_VIDEO_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
# Optional database: sqlite remains the default. See .env.mysql.example.
# CREATION_DB_BACKEND=sqlite

# Optional purpose-specific models; empty values keep AIHUBMIX_MODEL.
AIHUBMIX_DEFAULTS_MODEL=
AIHUBMIX_DIALOGUE_MODEL=
